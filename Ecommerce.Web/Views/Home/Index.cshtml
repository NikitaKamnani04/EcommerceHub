@* @model batata hai ye page kis type ka data expect karta hai
   List<ProductViewModel> - matlab humein products ki poori list milegi Controller se *@
@model Ecommerce.Web.Models.PagedProductsViewModel

@{
    // ViewData["Title"] - ye browser tab mein title dikhane ke liye hai
    // (jo humne _Layout.cshtml mein @ViewData["Title"] likha tha, wahi yahan set ho raha hai)
    ViewData["Title"] = "Home";
}

<div class="container">
    <div class="hero-section text-center mb-5">
        <h1>Welcome to EcommerceHub</h1>
        <p class="lead">Discover the best products at unbeatable prices</p>
    </div>

    <form method="get" asp-controller="Home" asp-action="Index" class="mb-4">
    <div class="input-group" style="max-width: 400px;">
        <input type="text" name="search" class="form-control" 
               placeholder="Search products..." value="@Model.SearchTerm" />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

    <h2 class="mb-4">Featured Products</h2>

    @* Check karo products list khaali toh nahi hai *@
    @if (!Model.Items.Any())
    {
        <p>No products available right now.</p>
    }
    else
    {
        <div class="row">
            @* foreach loop - Model (products list) ke har item ke liye ek card banayenge *@
            @foreach (var product in Model.Items)
            {
                <div class="col-md-4 mb-4">
                    <div class="card product-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductId"
                                   class="text-decoration-none flex-grow-1">
                                    <h5 class="card-title">@product.ProductName</h5>
                                </a>

                                @* Chhota heart icon button - card ke top-right corner mein *@
                                <button type="button" class="wishlist-icon-btn wishlist-btn" data-product-id="@product.ProductId">
                                    ♡
                                </button>
                            </div>

                            <p class="price">₹@product.Price.ToString("N0")</p>
                            <p class="text-muted">
                                @if (product.StockQuantity > 0)
                                {
                                    <span>In Stock</span>
                                }
                                else
                                {
                                    <span class="badge-sale">Out of Stock</span>
                                }
                            </p>
                            <button class="btn btn-primary add-to-cart-btn" data-product-id="@product.ProductId">
                                Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @* Previous button - agar page 1 hai toh disable *@
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-controller="Home" asp-action="Index"
                       asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.SearchTerm">Previous</a>
                </li>

                @* Har page number ke liye ek button *@
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-controller="Home" asp-action="Index"
                           asp-route-page="@i" asp-route-search="@Model.SearchTerm">@i</a>
                    </li>
                }

                @* Next button - agar last page hai toh disable *@
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-controller="Home" asp-action="Index"
                       asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.SearchTerm">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>