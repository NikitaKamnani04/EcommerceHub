@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="container text-center py-5">
    <h1 class="text-success mb-3">✓ Order Placed Successfully!</h1>

    @if (TempData["OrderSuccess"] != null)
    {
        <p class="lead">@TempData["OrderSuccess"]</p>
    }

    <p>Thank you for shopping with EcommerceHub.</p>

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
        Continue Shopping
    </a>
</div>