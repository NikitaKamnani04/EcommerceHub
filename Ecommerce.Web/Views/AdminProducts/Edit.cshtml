@model Ecommerce.Web.Models.ProductEditViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container">
    <h1 class="mb-4">Edit Product</h1>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-controller="AdminProducts" asp-action="Edit" asp-route-id="@Model.Product.ProductId" method="post">
        <input type="hidden" asp-for="Product.ProductId" />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Product Name</label>
                <input asp-for="Product.ProductName" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Price</label>
                <input asp-for="Product.Price" class="form-control" type="number" step="0.01" />
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Category</label>
                <select asp-for="Product.CategoryID" id="categoryDropdown" class="form-select">
                    <option value="">-- Select Category --</option>
                    @foreach (var cat in Model.Categories)
                    {
                        @* selected="selected" - agar ye category product ki current category hai, toh use pre-select karo *@
                        @if (cat.Id == Model.Product.CategoryID)
                        {
                            <option value="@cat.Id" selected="selected">@cat.Name</option>
                        }
                        else
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Sub Category</label>
                <select asp-for="Product.SubCategoryID" id="subCategoryDropdown" class="form-select">
                    @* Yahan JS load karke hi options daalega - neeche Scripts section mein *@
                </select>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Brand</label>
                <select asp-for="Product.BrandID" class="form-select">
                    <option value="">-- Select Brand --</option>
                    @foreach (var brand in Model.Brands)
                    {
                        @if (brand.Id == Model.Product.BrandID)
                        {
                            <option value="@brand.Id" selected="selected">@brand.Name</option>
                        }
                        else
                        {
                            <option value="@brand.Id">@brand.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Stock Quantity</label>
                <input asp-for="Product.StockQuantity" class="form-control" type="number" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Update Product</button>
        <a asp-controller="AdminProducts" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <script>
        const allSubCategories = @Html.Raw(Json.Serialize(Model.SubCategories));
        const currentCategoryId = @Model.Product.CategoryID;
        const currentSubCategoryId = @Model.Product.SubCategoryID;

        // Function - SubCategory dropdown ko populate karta hai, ek Category ke hisaab se
        // "preSelectId" - agar diya gaya hai, us SubCategory ko "selected" bana dega (Edit page ke liye)
        function populateSubCategories(categoryId, preSelectId) {
            const subCategoryDropdown = $('#subCategoryDropdown');
            subCategoryDropdown.empty();
            subCategoryDropdown.append('<option value="">-- Select Sub Category --</option>');

            const filtered = allSubCategories.filter(sc => sc.categoryId === categoryId);

            filtered.forEach(sc => {
                // Agar ye wahi subcategory hai jo product ki current hai, toh "selected" attribute lagao
                const isSelected = (sc.id === preSelectId) ? 'selected' : '';
                subCategoryDropdown.append(`<option value="${sc.id}" ${isSelected}>${sc.name}</option>`);
            });
        }

        // PAGE LOAD HOTE HI - current category ki subcategories load karo, current subcategory ko pre-select karo
        // Ye Create page se alag hai - wahan page load pe kuch nahi hota tha, yahan turant hona chahiye
        $(document).ready(function () {
            populateSubCategories(currentCategoryId, currentSubCategoryId);
        });

        // Jab Category badle (user manually change kare), SubCategory dropdown reset karo (koi pre-select nahi ab)
        $('#categoryDropdown').on('change', function () {
            const selectedCategoryId = parseInt($(this).val());
            populateSubCategories(selectedCategoryId, null);
        });
    </script>
}