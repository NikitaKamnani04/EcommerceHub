@model List<Ecommerce.Web.Models.ProductListItemModel>

@{
    ViewData["Title"] = "Manage Products";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Manage Products</h1>
        @* Naya product add karne ka button - Create page pe le jayega *@
        <a asp-controller="AdminProducts" asp-action="Create" class="btn btn-primary">
            + Add New Product
        </a>
    </div>

    @* Success/Error messages dikhao agar TempData mein hain *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Product Name</th>
                <th>Price</th>
                <th>Stock</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.ProductId</td>
                    <td>@product.ProductName</td>
                    <td>₹@product.Price.ToString("N0")</td>
                    <td>@product.StockQuantity</td>
                    <td>
                        @* Edit button - Edit page pe le jayega, product ki ID ke saath *@
                        <a asp-controller="AdminProducts" asp-action="Edit" asp-route-id="@product.ProductId"
                           class="btn btn-sm btn-outline-primary">Edit</a>

                        @* Delete button - ek chhota form hai jo POST karega (link se DELETE karna sahi practice nahi hai) *@
                        <form asp-controller="AdminProducts" asp-action="Delete" asp-route-id="@product.ProductId"
                              method="post" style="display: inline;"
                              onsubmit="return confirm('Are you sure you want to delete this product?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>