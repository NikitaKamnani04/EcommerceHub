@model Ecommerce.Web.Models.CouponCreateFormModel

@{
    ViewData["Title"] = "Create Coupon";
}

<div class="container">
    <h1 class="mb-4">Create New Coupon</h1>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-controller="AdminCoupons" asp-action="Create" method="post">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Coupon Code</label>
                <input asp-for="CouponCode" class="form-control" placeholder="e.g. SAVE10" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Discount Type</label>
                <select asp-for="DiscountType" class="form-select">
                    <option value="Percentage">Percentage (%)</option>
                    <option value="Flat">Flat Amount (₹)</option>
                </select>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Discount Value</label>
                <input asp-for="DiscountValue" class="form-control" type="number" step="0.01" />
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Minimum Order Amount</label>
                <input asp-for="MinOrderAmount" class="form-control" type="number" />
            </div>

            <div class="col-md-4 mb-3"></div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Start Date</label>
                <input asp-for="StartDate" class="form-control" type="date" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">End Date</label>
                <input asp-for="EndDate" class="form-control" type="date" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Create Coupon</button>
        <a asp-controller="AdminCoupons" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>