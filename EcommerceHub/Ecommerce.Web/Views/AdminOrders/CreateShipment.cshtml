@model Ecommerce.Web.Models.ShipmentCreateFormModel

@{
    ViewData["Title"] = "Create Shipment";
}

<div class="container">
    <h1 class="mb-4">Create Shipment for Order #@Model.OrderID</h1>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-controller="AdminOrders" asp-action="CreateShipment" method="post">
        <input type="hidden" asp-for="OrderID" />

        <div class="mb-3">
            <label class="form-label">Tracking Number</label>
            <input asp-for="TrackingNumber" class="form-control" placeholder="e.g. TRK123456789" />
        </div>

        <div class="mb-3">
            <label class="form-label">Courier Name</label>
            <input asp-for="CourierName" class="form-control" placeholder="e.g. Delhivery, BlueDart" />
        </div>

        <div class="mb-3">
            <label class="form-label">Estimated Delivery Date</label>
            <input asp-for="EstimatedDelivery" class="form-control" type="date" />
        </div>

        <button type="submit" class="btn btn-primary">Create Shipment</button>
        <a asp-controller="AdminOrders" asp-action="Details" asp-route-id="@Model.OrderID" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>