@model Ecommerce.Web.Models.ProductCreateViewModel

@{
    ViewData["Title"] = "Add New Product";
}

<div class="container">
    <h1 class="mb-4">Add New Product</h1>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    @* asp-for="Product.ProductName" - kyunki ab Model ek wrapper hai (ProductCreateViewModel),
       actual form fields "Product" property ke andar hain *@
    <form asp-controller="AdminProducts" asp-action="Create" method="post">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Product Name</label>
                <input asp-for="Product.ProductName" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Price</label>
                <input asp-for="Product.Price" class="form-control" type="number" step="0.01" />
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Category</label>
                @* asp-items - ye dropdown ko automatically Categories list se populate kar deta hai
                   SelectListItem banane ke liye .Select() use kar rahe hain neeche *@
                <select asp-for="Product.CategoryID" id="categoryDropdown" class="form-select">
                    <option value="">-- Select Category --</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Sub Category</label>
                <select asp-for="Product.SubCategoryID" id="subCategoryDropdown" class="form-select">
                    <option value="">-- Select Category First --</option>
                    @* Shuru mein khaali rahega - JS se Category select karte hi populate hoga *@
                </select>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Brand</label>
                <select asp-for="Product.BrandID" class="form-select">
                    <option value="">-- Select Brand --</option>
                    @foreach (var brand in Model.Brands)
                    {
                        <option value="@brand.Id">@brand.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Stock Quantity</label>
                <input asp-for="Product.StockQuantity" class="form-control" type="number" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Add Product</button>
        <a asp-controller="AdminProducts" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <script>
        // Saari SubCategories ka data JS mein store kar rahe hain (Razor se JSON banaya)
        // taaki JS ke paas poora data ho, filtering client-side pe ho (fast, bina server call ke)
        const allSubCategories = @Html.Raw(Json.Serialize(Model.SubCategories));

        // Jab bhi Category dropdown change ho, SubCategory dropdown update karo
        $('#categoryDropdown').on('change', function () {
            const selectedCategoryId = parseInt($(this).val());

            // Pehle SubCategory dropdown khaali karo
            const subCategoryDropdown = $('#subCategoryDropdown');
            subCategoryDropdown.empty();
            subCategoryDropdown.append('<option value="">-- Select Sub Category --</option>');

            // Sirf wahi subcategories filter karo jo selected category ki hain
            const filtered = allSubCategories.filter(sc => sc.categoryId === selectedCategoryId);

            // Har matching subcategory ke liye ek <option> add karo
            filtered.forEach(sc => {
                subCategoryDropdown.append(`<option value="${sc.id}">${sc.name}</option>`);
            });
        });
    </script>
}